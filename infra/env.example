BSConnect Environment Variables
Copy this file to .env and fill in values
  cp .env.example .env
NEVER commit .env to source control


# Postgres
# Root superuser password (used by the postgres container itself)
POSTGRES_ROOT_PASSWORD=changeme

# Password for the api_user role (used by the API at runtime)
POSTGRES_API_PASSWORD=changeme

# Password for the migrations_user role (used by EF Core migrations only)
POSTGRES_MIGRATIONS_PASSWORD=changeme

# Redis
REDIS_PASSWORD=changeme

# Vault
# Populated after running: make vault-init
# Do not set this until Vault has been initialized
VAULT_TOKEN=

# JWT
# The issuer should match your domain in production
# In dev you can use anything e.g. http://localhost:8080
JWT_ISSUER=https://bsconnect.org
JWT_AUDIENCE=bsconnect

# How long access tokens are valid (minutes)
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15

# How long refresh tokens are valid (days)
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30

# Grafana
GRAFANA_PASSWORD=changeme

# PgAdmin (dev only)
PGADMIN_EMAIL=admin@bsconnect.org
PGADMIN_PASSWORD=admin
