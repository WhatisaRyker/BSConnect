# ─────────────────────────────────────────
# BSConnect — Root .gitignore
# ─────────────────────────────────────────

# ── Secrets (NEVER commit these) ─────────
infra/.env
infra/vault/vault-init.json
infra/vault/unseal-keys.json

# ── .NET Build Artifacts ──────────────────
**/bin/
**/obj/
*.user
*.suo
.vs/
.idea/

# ── .NET Publish Output ───────────────────
**/publish/
**/out/

# ── EF Core Migrations Snapshot (optional)
# Uncomment if you want to exclude auto-generated snapshots
# **/Migrations/

# ── NuGet ─────────────────────────────────
*.nupkg
*.snupkg
.nuget/
packages/
project.lock.json

# ── Logs ──────────────────────────────────
*.log
logs/
**/Logs/

# ── OS ────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ── Docker ────────────────────────────────
# Keep compose files but ignore any local overrides
infra/docker-compose.local.yml

# ── Rider / JetBrains ─────────────────────
.idea/
*.sln.iml

# ── VS Code ───────────────────────────────
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# ── Visual Studio ─────────────────────────
*.rsuser
*.userosscache
*.sln.docstates
.localhistory/

# ── Test Results ──────────────────────────
TestResults/
coverage/
*.coverage
*.coveragexml
lcov.info

# ── Proto Generated Files ─────────────────
# Uncomment if you prefer to gitignore generated code
# BSConnect-Protos/Generated/

# ── Node (proto build scripts) ────────────
BSConnect-Protos/scripts/node_modules/
BSConnect-Protos/scripts/package-lock.json